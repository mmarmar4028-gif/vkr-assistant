# Скопируйте этот файл под именем .env.local и подставьте свои значения.
# Файл .env.local в репозиторий не попадает (он указан в .gitignore).

# Supabase → Project Settings → API (или кнопка Connect) → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://ваш-проект.supabase.co

# Supabase → Project Settings → API Keys → публичный ключ
# (называется "publishable" или "anon public"). НЕ service_role и НЕ secret!
NEXT_PUBLIC_SUPABASE_ANON_KEY=ваш-публичный-ключ

# --- Только для проверки изоляции данных (npm run check:rls-live) ---
# Два тестовых пользователя. Создайте их в Supabase: Authentication → Users →
# Add user → Create new user (галочка Auto Confirm User). На сайт не нужны.
RLS_TEST_EMAIL_A=
RLS_TEST_PASSWORD_A=
RLS_TEST_EMAIL_B=
RLS_TEST_PASSWORD_B=
