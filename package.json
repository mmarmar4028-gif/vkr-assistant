{
  "name": "vkr-assistant",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint",
    "test": "vitest run",
    "test:rls": "vitest run tests/rls.test.ts",
    "typecheck": "tsc --noEmit",
    "check:rls-live": "node --env-file=.env.local scripts/check-rls-live.mjs",
    "build:pages": "NEXT_PUBLIC_BASE_PATH=/vkr-assistant next build"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "docx": "^9.15.4",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
